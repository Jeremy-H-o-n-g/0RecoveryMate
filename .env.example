# No secrets are required for the static local-first baseline.
# NEXT_PUBLIC_SITE_URL=https://example.invalid

# --- Admin media uploads (optional; feature fails closed when unset) ---------
# Vercel Blob read/write token. On Vercel this is auto-injected when the Blob
# store is connected (Storage tab). For local dev, copy it from
# Vercel dashboard -> Storage -> <store> -> connect project / .env.local snippet.
# Missing => public pages render base content only; admin APIs answer 503.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Shared secret gating the /admin/upload surface (no accounts — one secret).
# Generate with: openssl rand -hex 32. Must be added MANUALLY on Vercel
# (Settings -> Environment Variables, mark Sensitive) followed by a redeploy.
# Missing => login impossible and every admin endpoint fails closed (503).
# UPLOAD_ADMIN_TOKEN=...
